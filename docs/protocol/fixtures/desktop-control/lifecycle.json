{
  "status": "prepared-not-executed",
  "platforms": [
    "macos",
    "windows"
  ],
  "capability": {
    "desktopControl": 1
  },
  "releaseHint": "You are controlling the workspace primary desktop. Call ws.desktop.endControl() as soon as your desktop work is finished.",
  "routerMethods": [
    "desktop.getState",
    "desktop.respondPermission",
    "desktop.revoke",
    "desktop.setPermission"
  ],
  "reverseMethods": [
    "desktop.control"
  ],
  "eventTypes": [
    "desktop:permission-changed",
    "desktop:permission-requested",
    "desktop:permission-resolved",
    "desktop:session-changed"
  ],
  "cases": [
    {
      "id": "start-unremembered",
      "before": "inactive",
      "call": {
        "binding": "ws.desktop.startControl",
        "args": {}
      },
      "expect": {
        "result": {
          "status": "pending_permission",
          "requestId": "request-a",
          "message": "End this turn and wait for the desktop control permission outcome."
        },
        "promptCount": 1,
        "executionAllowed": false
      }
    },
    {
      "id": "start-pending-again",
      "before": "pending_permission",
      "call": {
        "binding": "ws.desktop.startControl",
        "args": {}
      },
      "expect": {
        "result": {
          "status": "pending_permission",
          "requestId": "request-a",
          "message": "End this turn and wait for the desktop control permission outcome."
        },
        "promptCount": 0,
        "executionAllowed": false
      }
    },
    {
      "id": "start-remembered",
      "before": "inactive",
      "call": {
        "binding": "ws.desktop.startControl",
        "args": {}
      },
      "expect": {
        "result": {
          "status": "active",
          "sessionId": "session-a",
          "alreadyGranted": false,
          "computerName": "Studio",
          "message": "Desktop control is active",
          "hint": "You are controlling the workspace primary desktop. Call ws.desktop.endControl() as soon as your desktop work is finished."
        },
        "remembered": true,
        "localReady": true,
        "startToastCount": 1
      }
    },
    {
      "id": "start-active-again",
      "before": "active",
      "call": {
        "binding": "ws.desktop.startControl",
        "args": {}
      },
      "expect": {
        "result": {
          "status": "active",
          "sessionId": "session-a",
          "alreadyGranted": true,
          "computerName": "Studio",
          "message": "Control is already granted",
          "hint": "You are controlling the workspace primary desktop. Call ws.desktop.endControl() as soon as your desktop work is finished."
        },
        "localReady": true,
        "startToastCount": 0
      }
    },
    {
      "id": "end-active",
      "before": "active",
      "call": {
        "binding": "ws.desktop.endControl",
        "args": {}
      },
      "expect": {
        "result": {
          "ended": true,
          "withdrawn": false
        },
        "after": {
          "status": "inactive"
        },
        "localTeardownConfirmed": true
      }
    },
    {
      "id": "end-inactive",
      "before": "inactive",
      "call": {
        "binding": "ws.desktop.endControl",
        "args": {}
      },
      "expect": {
        "result": {
          "ended": false,
          "withdrawn": false
        },
        "after": {
          "status": "inactive"
        }
      }
    },
    {
      "id": "withdraw-pending",
      "before": "pending_permission",
      "call": {
        "binding": "ws.desktop.endControl",
        "args": {}
      },
      "expect": {
        "result": {
          "ended": false,
          "withdrawn": true
        },
        "after": {
          "status": "inactive"
        }
      }
    },
    {
      "id": "end-failed",
      "before": "active",
      "call": {
        "binding": "ws.desktop.endControl",
        "args": {}
      },
      "expect": {
        "error": {
          "code": -32603,
          "data": {
            "code": "desktop-execution-failed",
            "detail": "execution failed"
          }
        },
        "after": {
          "status": "inactive"
        }
      }
    },
    {
      "id": "primary-offline",
      "before": "inactive",
      "call": {
        "binding": "ws.desktop.startControl",
        "args": {}
      },
      "expect": {
        "error": {
          "code": -32603,
          "data": {
            "code": "desktop-offline",
            "detail": "offline"
          }
        },
        "after": {
          "status": "inactive"
        },
        "fallbackClientSelected": false
      }
    },
    {
      "id": "primary-incapable",
      "before": "inactive",
      "call": {
        "binding": "ws.desktop.startControl",
        "args": {}
      },
      "expect": {
        "error": {
          "code": -32603,
          "data": {
            "code": "desktop-unsupported",
            "detail": "unsupported"
          }
        },
        "after": {
          "status": "inactive"
        },
        "fallbackClientSelected": false
      }
    },
    {
      "id": "desktop-owned-by-other-backend",
      "before": "inactive",
      "call": {
        "binding": "ws.desktop.startControl",
        "args": {}
      },
      "expect": {
        "error": {
          "code": -32603,
          "data": {
            "code": "desktop-busy",
            "detail": "busy"
          }
        },
        "after": {
          "status": "inactive"
        },
        "fallbackClientSelected": false
      }
    },
    {
      "id": "native-not-ready",
      "before": "inactive",
      "call": {
        "binding": "ws.desktop.startControl",
        "args": {}
      },
      "expect": {
        "error": {
          "code": -32603,
          "data": {
            "code": "desktop-os-permission-required",
            "detail": "os permission required"
          }
        },
        "after": {
          "status": "inactive"
        },
        "fallbackClientSelected": false
      }
    },
    {
      "id": "forged-agent-id",
      "before": "inactive",
      "call": {
        "binding": "ws.desktop.startControl",
        "args": {
          "agentId": "other-agent"
        }
      },
      "expect": {
        "error": {
          "code": -32602,
          "data": {
            "code": "invalid-params",
            "detail": "invalid params"
          }
        }
      }
    },
    {
      "id": "stale-approval-after-withdrawal",
      "before": "inactive",
      "call": {
        "method": "desktop.respondPermission",
        "params": {
          "workspaceId": "ws-a",
          "requestId": "request-a",
          "decision": "allow_future"
        }
      },
      "expect": {
        "error": {
          "code": -32602,
          "data": {
            "code": "desktop-stale-request",
            "detail": "stale request"
          }
        },
        "remembered": false,
        "after": {
          "status": "inactive"
        }
      }
    },
    {
      "id": "foreign-primary-approval",
      "before": "pending_permission",
      "call": {
        "method": "desktop.respondPermission",
        "params": {
          "workspaceId": "ws-a",
          "requestId": "request-a",
          "decision": "allow_once"
        }
      },
      "expect": {
        "error": {
          "code": -32003,
          "data": {
            "code": "forbidden",
            "detail": "forbidden"
          }
        },
        "remembered": false
      }
    },
    {
      "id": "screenshot-after-stop",
      "before": "inactive",
      "call": {
        "binding": "ws.desktop.screenshot",
        "args": {}
      },
      "expect": {
        "error": {
          "code": -32602,
          "data": {
            "code": "desktop-not-active",
            "detail": "not active",
            "execution": "not_started"
          }
        }
      }
    },
    {
      "id": "right-double-click",
      "before": "active",
      "call": {
        "binding": "ws.desktop.click",
        "args": {
          "displayId": "display-left",
          "layoutId": "layout-a",
          "x": 100,
          "y": 75,
          "button": "right",
          "clickCount": 2
        }
      },
      "expect": {
        "result": {
          "ok": true
        }
      }
    },
    {
      "id": "stale-layout",
      "before": "active",
      "call": {
        "binding": "ws.desktop.click",
        "args": {
          "displayId": "display-left",
          "layoutId": "layout-old",
          "x": 100,
          "y": 75
        }
      },
      "expect": {
        "error": {
          "code": -32602,
          "data": {
            "code": "desktop-stale-layout",
            "detail": "stale layout",
            "execution": "not_started"
          }
        }
      }
    },
    {
      "id": "input-transport-timeout",
      "before": "active",
      "call": {
        "binding": "ws.desktop.type",
        "args": {
          "text": "hello"
        }
      },
      "expect": {
        "error": {
          "code": -32603,
          "data": {
            "code": "desktop-outcome-unknown",
            "detail": "outcome unknown",
            "execution": "unknown"
          }
        },
        "after": {
          "status": "inactive"
        },
        "retry": false
      }
    },
    {
      "id": "windows-secure-desktop",
      "before": "active",
      "call": {
        "binding": "ws.desktop.keypress",
        "args": {
          "key": "Enter"
        }
      },
      "expect": {
        "error": {
          "code": -32603,
          "data": {
            "code": "desktop-unsupported-operation",
            "detail": "unsupported operation",
            "execution": "not_started"
          }
        },
        "after": {
          "status": "inactive"
        }
      }
    },
    {
      "id": "partial-drag",
      "before": "active",
      "call": {
        "binding": "ws.desktop.drag",
        "args": {
          "displayId": "display-left",
          "layoutId": "layout-a",
          "from": {
            "x": 10,
            "y": 10
          },
          "to": {
            "x": 200,
            "y": 250
          }
        }
      },
      "expect": {
        "error": {
          "code": -32603,
          "data": {
            "code": "desktop-execution-failed",
            "detail": "execution failed",
            "execution": "partial"
          }
        },
        "heldInputReleased": true
      }
    },
    {
      "id": "mixed-dpi-screenshot",
      "before": "active",
      "call": {
        "binding": "ws.desktop.screenshot",
        "args": {}
      },
      "expect": {
        "result": {
          "capturedAt": "2026-10-02T08:30:00Z",
          "layoutId": "layout-a",
          "displays": [
            {
              "displayId": "display-left",
              "width": 1920,
              "height": 1080,
              "originX": -1920,
              "originY": 0,
              "scaleFactor": 1,
              "assetId": "asset-a",
              "url": "intent://local/file/.intent/assets/a.png",
              "mimeType": "image/png"
            },
            {
              "displayId": "display-main",
              "width": 3840,
              "height": 2160,
              "originX": 0,
              "originY": 0,
              "scaleFactor": 2,
              "assetId": "asset-b",
              "url": "intent://local/file/.intent/assets/b.png",
              "mimeType": "image/png"
            }
          ]
        },
        "overlayExcluded": true,
        "pulseCount": 1
      }
    },
    {
      "id": "screenshot-save-failure",
      "before": "active",
      "call": {
        "binding": "ws.desktop.screenshot",
        "args": {}
      },
      "expect": {
        "error": {
          "code": -32603,
          "data": {
            "code": "desktop-execution-failed",
            "detail": "execution failed",
            "execution": "partial"
          }
        },
        "pulseCount": 0
      }
    }
  ],
  "races": [
    {
      "id": "grant-before-turn-end",
      "steps": [
        "start-pending",
        "approve",
        "local-ready",
        "queue-grant",
        "end-turn",
        "deliver-grant"
      ],
      "expect": {
        "wakeCount": 1,
        "concurrentTurns": false,
        "state": {
          "status": "active",
          "sessionId": "session-a",
          "computerName": "Studio",
          "hint": "You are controlling the workspace primary desktop. Call ws.desktop.endControl() as soon as your desktop work is finished."
        }
      }
    },
    {
      "id": "stop-before-grant-delivery",
      "steps": [
        "start-pending",
        "approve",
        "local-ready",
        "queue-grant",
        "user-stop",
        "end-turn",
        "deliver-revocation"
      ],
      "expect": {
        "activeGrantDelivered": false,
        "state": {
          "status": "inactive"
        },
        "automaticRestart": false
      }
    },
    {
      "id": "withdraw-before-ready",
      "steps": [
        "start-pending",
        "approve",
        "withdraw",
        "late-ready"
      ],
      "expect": {
        "activationAccepted": false,
        "localSessionEnded": true,
        "state": {
          "status": "inactive"
        }
      }
    },
    {
      "id": "stop-offline",
      "steps": [
        "remembered-start",
        "network-partition",
        "queue-input",
        "local-stop",
        "reconnect"
      ],
      "expect": {
        "queuedInputExecuted": false,
        "overlayVisible": false,
        "heldInputReleased": true,
        "remembered": true,
        "state": {
          "status": "inactive"
        },
        "automaticRestart": false
      }
    },
    {
      "id": "lease-expiry",
      "steps": [
        "remembered-start",
        "network-partition",
        "lease-expired",
        "late-renew",
        "late-input"
      ],
      "expect": {
        "queuedInputExecuted": false,
        "state": {
          "status": "inactive"
        },
        "automaticRestart": false
      }
    },
    {
      "id": "primary-change",
      "steps": [
        "start-pending",
        "primary-changed",
        "late-approval"
      ],
      "expect": {
        "activationAccepted": false,
        "remembered": false,
        "state": {
          "status": "inactive"
        }
      }
    },
    {
      "id": "ordinary-turn-boundary",
      "steps": [
        "remembered-start",
        "end-turn",
        "next-turn"
      ],
      "expect": {
        "state": {
          "status": "active",
          "sessionId": "session-a",
          "computerName": "Studio",
          "hint": "You are controlling the workspace primary desktop. Call ws.desktop.endControl() as soon as your desktop work is finished."
        }
      }
    },
    {
      "id": "agent-termination",
      "steps": [
        "remembered-start",
        "agent-completed"
      ],
      "expect": {
        "state": {
          "status": "inactive"
        },
        "localSessionEnded": true
      }
    },
    {
      "id": "permission-off-while-active",
      "steps": [
        "remembered-start",
        "menu-disable"
      ],
      "expect": {
        "remembered": false,
        "state": {
          "status": "active",
          "sessionId": "session-a",
          "computerName": "Studio",
          "hint": "You are controlling the workspace primary desktop. Call ws.desktop.endControl() as soon as your desktop work is finished."
        }
      }
    }
  ]
}
