{
  "formatVersion": 1,
  "status": "prepared-not-executed",
  "description": "Independent seeded examples for future real-WSS component tests. IDs and endpoint are fixture substitutions, not live resources. Each case gets fresh state; resultSubset is recursive inclusion, resultKeys are required root keys, event names require exactly one committed event. Initial/final subsets describe asynchronous agent results. No runner is installed by this docs change. checkpointOrderingCases are ordered internal capture/upload scenarios; inheritedWipCases are local/remote hydration and merge/publication scenarios. Both are prepared assertions, not executed runtime tests.",
  "setup": {
    "owner": "host owner",
    "member": "active host member, ordinary workspace manager, not administrator",
    "parent-agent": "agent-parent with persisted parent grant to agent-child/agent-discard only",
    "ws-owned": "ordinary managed workspace; agent-child has clean committed checkpoint and a clean persisted parent target",
    "node-static": "matching-version connected static node with confirmed stop support",
    "node-released": "released static registration with no live processes",
    "repo-main": "granted disposable forge repository with branch test/remote-child absent",
    "checkpoint-clean": "durable clean checkpoint with full Git objects and transcript watermark",
    "ws-no-capacity": "workspace with no eligible static capacity",
    "ws-clone-fails": "localNodeIsolation enabled; force clone failure after reservation",
    "retirement": "only the last two cases enable agentIsolation:2; all others use additive node flags"
  },
  "cases": [
    {
      "id": "register-static-owner",
      "caller": "owner",
      "request": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "node.register",
        "params": {
          "endpoint": "wss://node.example:9444/node",
          "certificateSha256": "1111111111111111111111111111111111111111111111111111111111111111",
          "bootstrapToken": "fixture-one-time-secret",
          "requestId": "00000000-0000-4000-8000-000000000001"
        }
      },
      "expect": {
        "resultSubset": {
          "node": {
            "kind": "static",
            "state": "ready"
          },
          "lease": {
            "state": "ready",
            "ackSeq": "0"
          }
        }
      }
    },
    {
      "id": "list-safe-capacity",
      "caller": "member",
      "request": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "node.list",
        "params": {
          "workspaceId": "ws-owned"
        }
      },
      "expect": {
        "resultKeys": [
          "nodes"
        ],
        "forbiddenRecursiveKeys": [
          "endpoint",
          "certificateSha256",
          "nodeIdentity",
          "leaseId",
          "bootstrapToken",
          "leaseToken"
        ]
      }
    },
    {
      "id": "drain-static",
      "caller": "owner",
      "request": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "node.drain",
        "params": {
          "nodeId": "node-static",
          "draining": true
        }
      },
      "expect": {
        "resultSubset": {
          "node": {
            "draining": true
          }
        },
        "event": "node:changed"
      }
    },
    {
      "id": "list-leases-owner",
      "caller": "owner",
      "request": {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "lease.list",
        "params": {
          "nodeId": "node-static"
        }
      },
      "expect": {
        "resultKeys": [
          "leases"
        ],
        "forbiddenRecursiveKeys": [
          "leaseToken",
          "bootstrapToken"
        ]
      }
    },
    {
      "id": "release-static",
      "caller": "owner",
      "request": {
        "jsonrpc": "2.0",
        "id": 5,
        "method": "lease.release",
        "params": {
          "leaseId": "lease-static",
          "requestId": "00000000-0000-4000-8000-000000000002"
        }
      },
      "expect": {
        "resultSubset": {
          "lease": {
            "state": "released",
            "releaseRequested": true
          }
        },
        "event": "lease:changed"
      }
    },
    {
      "id": "remove-released-static",
      "caller": "owner",
      "request": {
        "jsonrpc": "2.0",
        "id": 6,
        "method": "node.remove",
        "params": {
          "nodeId": "node-released"
        }
      },
      "expect": {
        "resultSubset": {
          "ok": true
        },
        "event": "node:changed"
      }
    },
    {
      "id": "merge-committed-child",
      "caller": "parent-agent",
      "request": {
        "jsonrpc": "2.0",
        "id": 7,
        "method": "hub.merge",
        "params": {
          "workspaceId": "ws-owned",
          "agentId": "agent-child",
          "checkpointId": "checkpoint-clean",
          "requestId": "00000000-0000-4000-8000-000000000003"
        }
      },
      "expect": {
        "resultSubset": {
          "ok": true,
          "status": "merged"
        },
        "resultKeys": [
          "commitRange",
          "canonicalHead"
        ],
        "event": "hub:merged"
      }
    },
    {
      "id": "discard-stopped-child",
      "caller": "parent-agent",
      "request": {
        "jsonrpc": "2.0",
        "id": 8,
        "method": "hub.discard",
        "params": {
          "workspaceId": "ws-owned",
          "agentId": "agent-discard",
          "requestId": "00000000-0000-4000-8000-000000000004"
        }
      },
      "expect": {
        "resultSubset": {
          "ok": true
        },
        "event": "hub:discarded"
      }
    },
    {
      "id": "publish-exact-checkpoint",
      "caller": "owner",
      "request": {
        "jsonrpc": "2.0",
        "id": 9,
        "method": "hub.publish",
        "params": {
          "workspaceId": "ws-owned",
          "agentId": "agent-child",
          "repoKey": "repo-main",
          "checkpointId": "checkpoint-clean",
          "branch": "test/remote-child",
          "expectedRemoteHead": null,
          "requestId": "00000000-0000-4000-8000-000000000005"
        }
      },
      "expect": {
        "resultSubset": {
          "repoKey": "repo-main",
          "branch": "test/remote-child",
          "checkpointId": "checkpoint-clean"
        },
        "resultKeys": [
          "headSha",
          "publishedAt"
        ]
      }
    },
    {
      "id": "member-cannot-enroll",
      "caller": "member",
      "request": {
        "jsonrpc": "2.0",
        "id": 10,
        "method": "node.register",
        "params": {
          "endpoint": "wss://node.example:9444/node",
          "certificateSha256": "1111111111111111111111111111111111111111111111111111111111111111",
          "bootstrapToken": "fixture-one-time-secret",
          "requestId": "00000000-0000-4000-8000-000000000006"
        }
      },
      "expect": {
        "errorCode": -32003,
        "noSideEffects": true
      }
    },
    {
      "id": "remote-no-capacity",
      "caller": "owner",
      "request": {
        "jsonrpc": "2.0",
        "id": 11,
        "method": "agent.create",
        "params": {
          "workspaceId": "ws-no-capacity",
          "name": "remote",
          "placement": {
            "target": "remote",
            "checkout": "isolated",
            "os": "linux"
          }
        }
      },
      "expect": {
        "errorCode": -32602,
        "errorDataCode": "placement-unavailable",
        "noSideEffects": true
      }
    },
    {
      "id": "isolated-no-shared-fallback",
      "caller": "owner",
      "request": {
        "jsonrpc": "2.0",
        "id": 12,
        "method": "agent.create",
        "params": {
          "workspaceId": "ws-clone-fails",
          "name": "isolated",
          "placement": {
            "target": "local",
            "checkout": "isolated"
          }
        }
      },
      "expect": {
        "initialSubset": {
          "effectiveIsolation": "pending"
        },
        "event": "agent:failed",
        "finalAgentSubset": {
          "status": "error"
        },
        "providerSpawns": 0
      }
    },
    {
      "id": "unknown-checkpoint",
      "caller": "owner",
      "request": {
        "jsonrpc": "2.0",
        "id": 13,
        "method": "hub.merge",
        "params": {
          "workspaceId": "ws-owned",
          "agentId": "agent-child",
          "checkpointId": "checkpoint-missing",
          "requestId": "00000000-0000-4000-8000-000000000007"
        }
      },
      "expect": {
        "errorCode": -32602,
        "errorDataCode": "checkpoint-not-found",
        "noSideEffects": true
      }
    },
    {
      "id": "cross-workspace-agent",
      "caller": "parent-agent",
      "request": {
        "jsonrpc": "2.0",
        "id": 14,
        "method": "hub.merge",
        "params": {
          "workspaceId": "ws-other",
          "agentId": "agent-child",
          "checkpointId": "checkpoint-clean",
          "requestId": "00000000-0000-4000-8000-000000000008"
        }
      },
      "expect": {
        "errorCode": -32602,
        "errorDataCode": "not-found",
        "noSideEffects": true
      }
    },
    {
      "id": "retired-cow-input",
      "caller": "owner",
      "request": {
        "jsonrpc": "2.0",
        "id": 15,
        "method": "agent.delegate",
        "params": {
          "workspaceId": "ws-owned",
          "taskNoteId": "task-cow",
          "isolation": "cow"
        }
      },
      "expect": {
        "errorCode": -32602,
        "errorDataCode": "isolation-removed",
        "noSideEffects": true
      }
    },
    {
      "id": "retired-cow-route",
      "caller": "owner",
      "request": {
        "jsonrpc": "2.0",
        "id": 16,
        "method": "sandbox.cow.merge",
        "params": {
          "workspaceId": "ws-owned",
          "agentId": "agent-child"
        }
      },
      "expect": {
        "errorCode": -32601,
        "noSideEffects": true
      }
    }
  ],
  "checkpointOrderingCases": [
    {
      "id": "reverse-upload-newer-watermark",
      "currentEpoch": "3",
      "captures": [
        {
          "id": "older",
          "assignmentEpoch": "3",
          "captureRevision": "8",
          "journalSeq": "40"
        },
        {
          "id": "newer",
          "assignmentEpoch": "3",
          "captureRevision": "9",
          "journalSeq": "50"
        }
      ],
      "uploadOrder": [
        "newer",
        "older"
      ],
      "expect": {
        "receipts": [
          "advanced",
          "historical"
        ],
        "currentCheckpointId": "newer",
        "aliasCheckpointId": "newer",
        "recoveryCheckpointId": "newer",
        "checkpointEvents": [
          "newer"
        ]
      }
    },
    {
      "id": "reverse-upload-same-watermark",
      "currentEpoch": "3",
      "captures": [
        {
          "id": "older",
          "assignmentEpoch": "3",
          "captureRevision": "8",
          "journalSeq": "50"
        },
        {
          "id": "newer",
          "assignmentEpoch": "3",
          "captureRevision": "9",
          "journalSeq": "50"
        }
      ],
      "uploadOrder": [
        "newer",
        "older"
      ],
      "expect": {
        "receipts": [
          "advanced",
          "historical"
        ],
        "currentCheckpointId": "newer",
        "aliasCheckpointId": "newer",
        "recoveryCheckpointId": "newer",
        "checkpointEvents": [
          "newer"
        ]
      }
    },
    {
      "id": "stale-assignment-upload",
      "currentEpoch": "4",
      "captures": [
        {
          "id": "stale",
          "assignmentEpoch": "3",
          "captureRevision": "99",
          "journalSeq": "60"
        }
      ],
      "uploadOrder": [
        "stale"
      ],
      "expect": {
        "errorDataCode": "stale-checkpoint-owner",
        "pointerUnchanged": true,
        "aliasesUnchanged": true,
        "checkpointEvents": []
      }
    },
    {
      "id": "duplicate-capture-revision",
      "currentEpoch": "3",
      "captures": [
        {
          "id": "first",
          "assignmentEpoch": "3",
          "captureRevision": "8",
          "journalSeq": "50"
        },
        {
          "id": "different",
          "assignmentEpoch": "3",
          "captureRevision": "8",
          "journalSeq": "50"
        }
      ],
      "uploadOrder": [
        "first",
        "different"
      ],
      "expect": {
        "secondErrorDataCode": "checkpoint-invalid",
        "currentCheckpointId": "first",
        "aliasCheckpointId": "first",
        "recoveryCheckpointId": "first",
        "checkpointEvents": [
          "first"
        ]
      }
    },
    {
      "id": "retry-older-advanced-receipt",
      "currentEpoch": "3",
      "captures": [
        {
          "id": "older",
          "assignmentEpoch": "3",
          "captureRevision": "8",
          "journalSeq": "40"
        },
        {
          "id": "newer",
          "assignmentEpoch": "3",
          "captureRevision": "9",
          "journalSeq": "50"
        }
      ],
      "uploadOrder": [
        "older",
        "newer",
        "older"
      ],
      "expect": {
        "thirdReceiptEqualsFirst": true,
        "currentCheckpointId": "newer",
        "aliasCheckpointId": "newer",
        "recoveryCheckpointId": "newer",
        "checkpointEvents": [
          "older",
          "newer"
        ]
      }
    }
  ],
  "inheritedWipCases": [
    {
      "id": "dirty-parent-local-and-remote",
      "placements": [
        "local",
        "remote"
      ],
      "parentState": [
        "staged edit",
        "unstaged edit",
        "untracked file",
        "initialized dirty submodule",
        "unpublished submodule commit"
      ],
      "expect": {
        "childFileContentsEqualCapture": true,
        "childStartsAtPrivateExecutionBase": true,
        "parentHeadIndexWorktreeUnchanged": true,
        "inheritedAttributionRemainsParent": true,
        "parentIndexSplitRetainedInSourceCheckpoint": true
      }
    },
    {
      "id": "inherited-only-child-merge",
      "childChanges": [],
      "expect": {
        "mergeDeltaEmpty": true,
        "parentHeadIndexWorktreeUnchanged": true,
        "inheritedCommitMerged": false
      }
    },
    {
      "id": "unrelated-child-edit",
      "childChanges": [
        "new child-owned path"
      ],
      "expect": {
        "mergeIncludesOnlyChildDelta": true,
        "unrelatedParentDirtyStateUnchanged": true,
        "inheritedCommitMerged": false,
        "syntheticGitlinksMerged": false
      }
    },
    {
      "id": "publish-independent-child-edit",
      "childChanges": [
        "new child-owned path"
      ],
      "expect": {
        "publishedHistoryExcludesSyntheticBaselines": true,
        "publishedHistoryExcludesInheritedDirtyFiles": true,
        "childAuthorPreserved": true
      }
    },
    {
      "id": "publish-child-requires-parent-wip",
      "childChanges": [
        "modify path existing only in inherited untracked parent work"
      ],
      "expect": {
        "errorDataCode": "inherited-baseline-required",
        "forgePushes": 0,
        "parentHeadIndexWorktreeUnchanged": true
      }
    }
  ]
}
