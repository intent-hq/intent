    { "id": "fallback-never-splits-crlf", "content": "abc\r\nd", "maxContentBytes": 4, "expect": { "content": "abc", "contentTruncated": true, "contentBytes": 6 } },
    { "id": "fallback-never-splits-crlf-multibyte", "content": "é\r\nx", "maxContentBytes": 3, "expect": { "content": "é", "contentTruncated": true, "contentBytes": 5 } }
