      "expect": {
        "newDirtyVersions": 0,
        "lossGenerationChanges": 0,
        "recoveryReads": 0,
        "consecutiveFailures": 2
      },
      "consumers": [
        "backend",
        "client"
      ]
    },
    {
      "id": "failed-end-fence-budget",
      "steps": [
