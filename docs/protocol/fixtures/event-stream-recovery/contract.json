  "scenarios": [
    {
      "id": "final-loss",
      "steps": [
        "register capacity-1 scoped receiver",
        "ack",
        "hold forwarding",
        "publish matching file event then enough unrelated events to overflow",
        "resume forwarding; publish nothing else"
      ],
      "expect": {
        "lossFrames": 1,
        "laterMatchingEvents": 0
      },
      "consumers": [
        "backend"
      ]
    },
    {
      "id": "ack-order",
      "steps": [
        "register receiver",
        "force overflow before ack enqueue",
        "enqueue ack",
        "start forwarding"
      ],
      "expect": {
        "wireOrder": [
          "ack",
          "lost"
        ]
      },
      "consumers": [
        "backend"
      ]
    },
    {
      "id": "conflation-barrier",
      "steps": [
        "fill output lane",
        "buffer pre-loss file update",
        "observe loss",
        "release output capacity",
        "publish post-loss file update"
      ],
      "expect": {
        "wireOrder": [
          "pre-loss-file",
          "lost",
          "post-loss-file"
        ],
        "mergeAcrossBarrier": false
      },
      "consumers": [
        "backend"
      ]
    },
    {
      "id": "writer-timeout",
      "steps": [
        "block output capacity",
        "observe loss",
        "advance paused clock 5000 ms"
      ],
      "expect": {
        "connectionClosed": true,
        "silentlyUsable": false
      },
      "consumers": [
        "backend"
      ]
    },
    {
      "id": "membership-only-loss",
      "steps": [
        "admit guarded subscriber",
        "cache allow and buffer event",
        "overflow only membership receiver",
        "make output writable"
      ],
      "expect": {
        "newGuardedFrames": 0,
        "connectionClosed": true,
        "cachedAllows": 0
      },
      "consumers": [
        "backend"
      ]
    },
    {
      "id": "replace-lease",
      "steps": [
        "admit old lease",
        "hold old queued marker",
        "replace same group",
        "ack new ID",
        "deliver old marker"
      ],
      "expect": {
        "oldReads": 0,
        "newLastGeneration": "0"
      },
      "consumers": [
        "backend",
        "client"
      ]
    },
    {
      "id": "generation-exhaustion",
      "steps": [
        "set generation to max-u64",
        "observe another loss"
      ],
      "expect": {
        "connectionClosed": true,
        "wrappedGeneration": false
      },
      "consumers": [
        "backend"
      ]
    },
    {
      "id": "early-marker",
      "steps": [
        "receive ack on wire",
        "hold renderer ack continuation",
        "deliver matching marker callback",
        "release ack continuation"
      ],
      "expect": {
        "readsBeforeAdmission": 0,
        "recoveryReads": 1
      },
      "consumers": [
        "client"
      ]
    },
    {
      "id": "early-staging-overflow",
      "steps": [
        "hold opted-in subscribe ack continuation",
        "stage 65 distinct candidate IDs",
        "release ack with one admitted lease"
      ],
      "expect": {
        "maxStagedIds": 64,
        "readsBeforeAdmission": 0,
        "admittedLeaseInvalidations": 1,
        "foreignReads": 0
      },
      "consumers": [
        "client"
      ]
    },
    {
      "id": "overlap-and-trailing",
      "steps": [
        "admit two overlapping leases for resource",
        "deliver loss to both before starting scheduler",
        "start and hold read",
        "deliver newer markers repeatedly",
        "resolve first read",
        "advance fake time to 250 ms",
        "resolve trailing read"
      ],
      "expect": {
        "reads": 2,
        "maxActive": 1,
        "maxPending": 1,
        "idleTimers": 0,
        "beginFenceRpcs": 2,
        "dataRpcs": 2,
        "endFenceRpcs": 2,
        "totalRpcs": 6
      },
      "consumers": [
        "client",
        "stores"
      ]
    },
    {
      "id": "sustained-success",
      "steps": [
        "loss at t=0; resolve read",
        "new loss each ms through t=999; resolve each read immediately",
        "advance fake time through t=1000"
      ],
      "expect": {
        "startTimesMs": [
          0,
          250,
          500,
          750,
          1000
        ],
        "idleTimers": 0
      },
      "consumers": [
        "client",
        "stores"
      ]
    },
    {
      "id": "finite-failures",
      "steps": [
        "loss at t=0; fail immediately",
        "advance to t=1000; fail retry immediately",
        "advance to t=5000; fail retry immediately",
        "deliver 100 more generations; advance to t=60000"
      ],
      "expect": {
        "startTimesMs": [
          0,
          1000,
          5000
        ],
        "reads": 3,
        "stale": true,
        "automaticSuspended": true,
        "beginFenceRpcs": 3,
        "dataRpcs": 3,
        "endFenceRpcs": 0,
        "totalRpcs": 6
      },
      "consumers": [
        "client",
        "stores"
      ]
    },
    {
      "id": "newer-push",
      "steps": [
        "loss; hold authoritative read",
        "accept newer state push",
        "resolve stale read"
      ],
      "expect": {
        "staleOverwrite": false,
        "maxPending": 1
      },
      "consumers": [
        "stores"
      ]
    },
    {
      "id": "teardown-and-aba",
      "steps": [
        "loss; hold read and trailing timer",
        "switch backend/principal/workspace A to B to A with new epochs",
        "resolve old read; advance timer"
      ],
      "expect": {
        "oldReplyWrites": 0,
        "oldTimerReads": 0
      },
      "consumers": [
        "client",
        "stores"
      ]
    },
    {
      "id": "inactive-resource",
      "steps": [
        "cache inactive resource",
        "admit loss",
        "advance fake time",
        "mount resource and resolve authoritative read"
      ],
      "expect": {
        "readsBeforeDemand": 0,
        "readsAfterDemand": 1
      },
      "consumers": [
        "stores"
      ]
    },
    {
      "id": "final-file-git-state",
      "steps": [
        "mount file tree/status/history views",
        "lose final file/git event",
        "deliver admitted loss only",
        "resolve authoritative reads with changed contents and immutable history identity"
      ],
      "expect": {
        "fileState": "authoritative",
        "gitState": "authoritative",
        "fabricatedHistoryIdentity": false,
        "transcriptReads": 0
      },
      "consumers": [
        "stores"
      ]
    },
    {
      "id": "legacy-fallback",
      "steps": [
        "connect without capability",
        "subscribe without opt-in",
        "simulate silently lost event",
        "explicit refresh",
        "reconnect and re-admit"
      ],
      "expect": {
        "markerRecoveryReads": 0,
        "explicitRefreshWorks": true,
        "reconnectWorks": true
      },
      "consumers": [
        "client",
        "stores"
      ]
    },
    {
      "id": "typed-channel-independence",
      "steps": [
        "mount typed note/chat/workspace channels",
        "deliver generic loss covering note/workspace resources",
        "resubscribe affected collection owners once; deliver fresh snapshots",
        "allow chat to perform its independent lag recovery"
      ],
      "expect": {
        "genericTranscriptReads": 0,
        "duplicateCollectionReads": 0,
        "collectionOwnerSnapshotsPerAffectedResource": 1
      },
      "consumers": [
        "stores"
      ]
    },
    {
      "id": "queued-writer-timeout",
      "steps": [
        "enqueue loss marker but hold socket writer",
        "advance paused clock to 5000 ms since loss observation"
      ],
      "expect": {
        "connectionClosed": true,
        "queueAdmissionIsDelivery": false
      },
      "consumers": [
        "backend"
      ]
    },
    {
      "id": "overlap-independent-generations",
      "steps": [
        "admit lease A generation 1; finish resource read",
        "admit later lease B generation 1 for the same resource",
        "advance fake clock to next paced start; finish read"
      ],
      "expect": {
        "reads": 2,
        "maxActive": 1
      },
      "consumers": [
        "client",
        "stores"
      ]
    },
    {
      "id": "queued-event-after-read",
      "steps": [
        "begin fence covering leases A and B completes after prior callbacks",
        "start authoritative read",
        "publish older script state S1 and hold its frame on lease B bulk path",
        "mutate/read current S2 and receive read response on priority lane; hold result",
        "request end fence; deliver queued S1 then end reply",
        "reject conflicted read without applying S1; perform paced begin/read/end cycle with no intervening events"
      ],
      "expect": {
        "reads": 2,
        "appliedSnapshots": [
          "S2"
        ],
        "appliedStalePushes": 0,
        "heldReadAppliedBeforeEndFence": false,
        "finalState": "S2",
        "maxPending": 1,
        "beginFenceRpcs": 2,
        "dataRpcs": 2,
        "endFenceRpcs": 2,
        "totalRpcs": 6
      },
      "consumers": [
        "stores"
      ]
    },
    {
      "id": "held-overlap-independent-generations",
      "steps": [
        "lease A generation 1 begins fenced read; hold it",
        "lease B generation 1 arrives for same resource",
        "replay A1 and B1 duplicates",
        "end first cycle; complete one paced trailing cycle"
      ],
      "expect": {
        "reads": 2,
        "maxActive": 1,
        "maxPending": 1,
        "duplicateInvalidations": 0
      },
      "consumers": [
        "client",
        "stores"
      ]
    },
    {
      "id": "fence-covers-bus-worker",
      "steps": [
        "publish S1 before begin fence; hold raw bus filter worker",
        "request begin fence",
        "release worker then conflation then bulk writer",
        "only after fence reply start authoritative read"
      ],
      "expect": {
        "fenceBeforeRawBoundary": false,
        "readBeforeFence": false,
        "wireOrder": [
          "S1",
          "fence-reply"
        ]
      },
      "consumers": [
        "backend",
        "client"
      ]
    },
    {
      "id": "fence-retired-set",
      "steps": [
        "request fence for leases A and B",
        "retire B while waiting on its barrier",
        "complete A barrier"
      ],
      "expect": {
        "successfulPartialFence": false,
        "errorCode": -32602,
        "snapshotApplied": false
      },
      "consumers": [
        "backend",
        "client"
      ]
    },
    {
      "id": "fence-ordered-ingress",
      "steps": [
        "receive old notification then bulk fence response on wire",
        "hold renderer notification callback",
        "allow response promise completion attempt",
        "release notification callback"
      ],
      "expect": {
        "fenceVisibleBeforeCallback": false,
        "readBeforeCallback": false
      },
      "consumers": [
        "client"
      ]
    },
    {
      "id": "fence-loss-window",
      "steps": [
        "begin fence completes",
        "read snapshot",
        "overflow receiver before end fence barrier",
        "emit loss then end fence response"
      ],
      "expect": {
        "snapshotApplied": false,
        "maxPending": 1,
        "lossBeforeFence": true
      },
      "consumers": [
        "backend",
        "client",
        "stores"
      ]
    },
    {
      "id": "fence-filtered-transient-tail",
      "steps": [
        "publish transient matching file update and filtered foreign events",
        "request fence then publish no later matching event",
        "drain raw worker, filters, conflation and writer"
      ],
      "expect": {
        "fenceCompletes": true,
        "foreignDomainFrames": 0,
        "barrierDomainFrames": 0
      },
      "consumers": [
        "backend"
      ]
    },
    {
      "id": "fence-new-overlap",
      "steps": [
        "begin fence for A and B completes; hold authoritative read",
        "admit lease C capable of mutating the same resource",
        "complete old read and end fence for A and B"
      ],
      "expect": {
        "snapshotApplied": false,
        "leaseSetEpochChanged": true,
        "maxPending": 1
      },
      "consumers": [
        "client",
        "stores"
      ]
    },
    {
      "id": "fence-control-only",
      "steps": [
