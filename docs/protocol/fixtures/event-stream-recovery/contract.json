{
  "status": "prepared-not-executed",
  "capability": {
    "eventStreamRecovery": 1
  },
  "policy": {
    "minReadStartIntervalMs": 250,
    "failureRetryDelaysMs": [
      1000,
      4000
    ],
    "maxConsecutiveFailures": 3,
    "maxEarlyMarkerIds": 64,
    "lossBarrierTimeoutMs": 5000
  },
  "consumers": {
    "backend": [
      "crates/intent-services/src/events/bus.rs",
      "crates/intent-transport/src/events/tests.rs",
      "crates/intentd/tests/e2e_wss_event_subscription.rs",
      "crates/intentd/tests/e2e_wss_egress_conflation.rs"
    ],
    "client": [
      "src/store/renderer/slices/workspace-events/sagas/daemon-events-saga.test.ts",
      "src/features/events/daemon-events-bridge.client.test.ts",
      "JSON-RPC and browser transport tests"
    ],
    "stores": [
      "src/store/renderer/slices/git/sagas/git-read-saga.test.ts",
      "src/lib/client/live/live-git-client.test.ts",
      "lifecycle/catalog/presence/recovery-owner tests"
    ]
  },
  "wire": {
    "scopedRequest": {
      "jsonrpc": "2.0",
      "id": 60,
      "method": "events.subscribe",
      "params": {
        "eventTypes": [
          "file:*"
        ],
        "workspaceId": "ws-a",
        "replaceGroup": "file-events",
        "lossRecovery": 1
      }
    },
    "scopedAck": {
      "jsonrpc": "2.0",
      "id": 60,
      "result": {
        "subscriptionId": "ws-sub-1",
        "lossRecovery": 1
      }
    },
    "legacyRequest": {
      "jsonrpc": "2.0",
      "id": 61,
      "method": "events.subscribe",
      "params": {
        "eventTypes": [
          "file:*"
        ],
        "workspaceId": "ws-a"
      }
    },
    "legacyAck": {
      "jsonrpc": "2.0",
      "id": 61,
      "result": {
        "subscriptionId": "ws-sub-legacy"
      }
    },
    "fenceRequest": {
      "jsonrpc": "2.0",
      "id": 62,
      "method": "events.fence",
      "params": {
        "subscriptionIds": [
          "ws-sub-1",
          "ws-sub-global"
        ]
      }
    },
    "fenceReply": {
      "jsonrpc": "2.0",
      "id": 62,
      "result": {
        "subscriptionIds": [
          "ws-sub-1",
          "ws-sub-global"
        ]
      }
    }
  },
  "negotiation": [
    {
      "id": "new-new",
      "capability": 1,
      "request": 1,
      "ack": 1,
      "admit": true
    },
    {
      "id": "old-client",
