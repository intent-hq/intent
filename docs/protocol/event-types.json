    "task:ready-tasks-changed": {
      "path": "data.triggeredBy.reason",
      "kind": "value",
      "values": [
        "note-deleted",
        "relations-changed"
      ],
      "absent": "status change: triggeredBy is { noteId, previousStatus, newStatus }"
    },
    "workspace:updated": {
