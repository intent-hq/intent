[submodule "packages/intentd"]
	path = packages/intentd
	url = https://github.com/intent-hq/intentd.git
	branch = main
[submodule "packages/cloudlands-fe"]
	path = packages/cloudlands-fe
	url = https://github.com/intent-hq/cloudlands-fe.git
	branch = main
[submodule "packages/ios"]
	path = packages/ios
	url = https://github.com/intent-hq/ios.git
	branch = main
	update = none
[submodule "packages/intent-apps"]
	path = packages/intent-apps
	url = https://github.com/intent-hq/intent-apps.git
	branch = main
[submodule "packages/intent-os"]
	path = packages/intent-os
	url = https://github.com/intent-hq/intent-os.git
	branch = main
