# GitHub runner slots on intent-mac2: Mac mini, M4 Pro (14 cores: 10
# performance + 4 efficiency), 64 GB, 2 TB, 10GbE. Each slot runs one job in
# a fresh Tart macOS VM. See docs/GITHUB_RUNNERS.md, "macOS hosts (Tart)".
# Not secret. Install on the Mac with:
#   sudo infra/runners/macos/install.sh --config infra/runners/macos/hosts/intent-mac2.env
GITHUB_ORG=intent-hq
RUNNER_GROUP=intent-cache
RUNNER_GROUP_REPOS=intent,intentd,cloudlands-fe
RUNNER_NAME_PREFIX=intent-mac2

# Two slots, the most macOS allows: Apple's licence and Virtualization.framework
# run at most two macOS guests per host. runner-route's macOS fleet is every
# online runner with self-hosted, macOS and ARM64 (it never routes on
# intent-mac or the host label); m1mac is the old persistent runner's label and
# is refused here.
MAC_SLOTS=2
MAC_LABELS=self-hosted,macOS,ARM64,intent-mac
# 2 x 6 vCPUs of 14 and 2 x 24 GB of 64: 2 cores and 16 GB stay with the host.
MAC_VM_CPU=6
MAC_VM_MEMORY_MB=24576
# The account that owns ~/.tart and runs the slots (never root).
MAC_HOST_USER=ci
# macos-tahoe-xcode 26.5 (macOS 26, like warp-macos-26-arm64-6x), by digest.
MAC_BASE_IMAGE=ghcr.io/cirruslabs/macos-tahoe-xcode@sha256:923c98d32e40ffadb6e6815a9722124b7a57bdf7d7763a708a2b28d1970831bd
