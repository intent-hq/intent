# GitHub runner slots on intent-cache (see docs/GITHUB_RUNNERS.md). Not secret.
# install.sh copies this to /etc/github-runners/runners.env once and never
# overwrites it; edit that copy and re-run install.sh --no-build to apply.
GITHUB_ORG=intent-hq
# Org runner group, by name. Slots refuse to register if it is missing.
RUNNER_GROUP=intent-cache
# Repositories (in GITHUB_ORG) that may use the group; install.sh applies it.
RUNNER_GROUP_REPOS=intent,intentd,cloudlands-fe
# Heavy slots only. Jobs that fit in 1 CPU run on free GitHub-hosted runners
# (ubuntu-24.04; the repositories are public), so this box has no small pool.
RUNNER_POOLS=heavy

# Heavy pool: full builds. One CPU set per slot (space-separated). CPU n and
# n+12 are SMT siblings on this box, so each heavy slot owns 4 whole cores and
# the three slots pin all 24 CPUs. No core is reserved for the cache: Caddy and
# sccache-webdav share CPUs with the slots and win contention by weight
# (CPUWeight/IOWeight 1000 from cache-priority.conf vs 10 for runners.slice).
# Memory: 3 x 36 GB = 108 GB, under the 116G runners.slice cap; measured
# heavy working memory is at most 25 GiB.
HEAVY_SLOTS=3
HEAVY_LABELS=self-hosted,linux,x64,intent-cache
HEAVY_CPUSETS=0-3,12-15 4-7,16-19 8-11,20-23
HEAVY_MEMORY=36g
HEAVY_PIDS=16384
HEAVY_SHM=1g
