# GitHub runner slots on intent-cache (see docs/GITHUB_RUNNERS.md). Not secret.
# install.sh copies this to /etc/github-runners/runners.env once and never
# overwrites it; edit that copy and re-run install.sh --no-build to apply.
GITHUB_ORG=intent-hq
RUNNER_GROUP_ID=1
RUNNER_POOLS=heavy small

# Heavy pool: full builds. One CPU set per slot (space-separated).
HEAVY_SLOTS=2
HEAVY_LABELS=self-hosted,linux,x64,intent-cache
HEAVY_CPUSETS=0-7 8-15
HEAVY_MEMORY=48g
HEAVY_PIDS=16384
HEAVY_SHM=1g

# Small pool: fast single-core jobs. CPUs 22-23 stay unpinned for the cache and system.
SMALL_SLOTS=6
SMALL_LABELS=self-hosted,linux,x64,intent-cache-small
SMALL_CPUSETS=16 17 18 19 20 21
SMALL_MEMORY=3g
SMALL_PIDS=4096
SMALL_SHM=256m
