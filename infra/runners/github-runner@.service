# One GitHub Actions runner slot: a fresh container per job, then restart.
# `systemctl stop` drains (waits for a running job). See docs/GITHUB_RUNNERS.md.
[Unit]
Description=GitHub Actions runner slot %i (ephemeral container)
Documentation=https://github.com/intent-hq/intent/blob/main/docs/GITHUB_RUNNERS.md
After=docker.service github-runners-egress.service network-online.target
Requires=docker.service github-runners-egress.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/local/lib/github-runners/supervisor.sh %i
Restart=always
RestartSec=5
# SIGTERM reaches only the supervisor, which drains; everything is killed
# if a job outlives TimeoutStopSec.
KillMode=mixed
TimeoutStopSec=6h
SyslogIdentifier=github-runner-%i

[Install]
WantedBy=multi-user.target
