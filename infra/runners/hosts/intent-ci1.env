# GitHub runner slots on intent-ci1, a runner-only host (no cache services):
# AMD EPYC 4545P, 16 cores / 32 threads, 128 GB. See docs/GITHUB_RUNNERS.md,
# "Add a runner host". Not secret. Install with:
#   infra/runners/install.sh --config infra/runners/hosts/intent-ci1.env
GITHUB_ORG=intent-hq
RUNNER_GROUP=intent-cache
RUNNER_GROUP_REPOS=intent,intentd,cloudlands-fe
RUNNER_NAME_PREFIX=intent-ci1
RUNNER_POOLS=xl heavy

# CPU n and n+16 are SMT siblings (Linux numbers every core's first thread,
# then every second thread; install.sh checks thread_siblings_list). Cores
# 0-7 and 8-15 sit on separate CCDs, so each slot stays on one CCD. Every
# core is pinned; the slots' memory leaves about 13 GiB of the 125 GiB for
# the system and Docker.

# xl pool: one 16-thread slot (cores 0-7, all of CCD 0) for gh-linux-16x jobs.
XL_SLOTS=1
XL_LABELS=self-hosted,linux,x64,intent-cache-xl
XL_CPUSETS=0-7,16-23
XL_MEMORY=52g
XL_PIDS=32768
XL_SHM=2g

# Heavy pool: two 8-thread slots, one per half of CCD 1 (cores 8-11 and
# 12-15), each with both SMT siblings of its cores.
HEAVY_SLOTS=2
HEAVY_LABELS=self-hosted,linux,x64,intent-cache
HEAVY_CPUSETS=8-11,24-27 12-15,28-31
HEAVY_MEMORY=30g
HEAVY_PIDS=16384
HEAVY_SHM=1g
