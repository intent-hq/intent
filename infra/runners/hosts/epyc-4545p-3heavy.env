# Alternative layout for a runner-only AMD EPYC 4545P host (16 cores /
# 32 threads, 128 GB): three heavy slots, no xl. Copy it, set
# RUNNER_NAME_PREFIX to the host's name, then install with
#   infra/runners/install.sh --config <copy>
# See docs/GITHUB_RUNNERS.md, "Add a runner host". Not secret.
GITHUB_ORG=intent-hq
RUNNER_GROUP=intent-cache
RUNNER_GROUP_REPOS=intent,intentd,cloudlands-fe
RUNNER_NAME_PREFIX=intent-runner-1
RUNNER_POOLS=heavy

# CPU n and n+16 are SMT siblings (install.sh checks thread_siblings_list).
# Each heavy slot owns 4 whole cores (0-3, 4-7, 8-11); cores 12-15 (CPUs
# 12-15 and 28-31) stay unpinned for the system and Docker.
HEAVY_SLOTS=3
HEAVY_LABELS=self-hosted,linux,x64,intent-cache
HEAVY_CPUSETS=0-3,16-19 4-7,20-23 8-11,24-27
HEAVY_MEMORY=32g
HEAVY_PIDS=16384
HEAVY_SHM=1g
