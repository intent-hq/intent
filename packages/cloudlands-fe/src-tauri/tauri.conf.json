{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "cloudlands-fe",
  "version": "0.1.0",
  "identifier": "ai.cloudlands.fe",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm sidecar && pnpm dev",
    "beforeBuildCommand": "pnpm sidecar && pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Cloudlands",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/intentd"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
